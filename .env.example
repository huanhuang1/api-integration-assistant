# Ollama runs locally. No API key is required for this prototype.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=nomic-embed-text:v1.5
# Optional overrides, resolved relative to the project directory.
ASSISTANT_SOURCE_DIR=data/source
ASSISTANT_STORE_DIR=data/generated
OLLAMA_TIMEOUT_SECONDS=120
